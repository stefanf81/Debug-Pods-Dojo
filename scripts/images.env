# Single source of truth for every third-party image the dojo runs or documents.
# Plain KEY="value" assignments so this file can be sourced from bash 3.2 and parsed by tools.
# ./scripts/validate.sh fails when LABS.md, the lab manifests, the scripts or the Dockerfiles
# reference one of these repositories with a different tag or digest.
#
# To bump an image: change it here, then update the other references to match
# (validate.sh lists every mismatch).

# Debug images used by the labs (LABS.md, command-e2e-test.sh, lab 06 and 14).
NETSHOOT_IMAGE="nicolaka/netshoot:v0.16@sha256:b09d9b21381f47a79b3cbcb30da25266dc17186ea00ae65e99fdc51396f48e70"
JDK_IMAGE="eclipse-temurin:21.0.12.1_1-jdk-jammy@sha256:742daacb9316be4b6fc60258f6e4ac2a11882f6c597373c92290a57bfad0d2e0"
STORAGE_IMAGE="tazhate/k8s-debug-container-storage@sha256:8e40c1db9d086e4375040984a6ff0362fcfdfd6f8119a812664225f850a2ff28"
DB_IMAGE="tazhate/k8s-debug-container-db@sha256:3f3e58b3f6e4b3e2a1b3846d7a74ec1a6cb7e3742c57498fa60e145a2f6b3672"
PERF_IMAGE="tazhate/k8s-debug-container-perf@sha256:a7547e55a0a6a7d0d0cd7bb8ff94143950fdc0794551da3e5718c0add577ebdf"
STRESS_IMAGE="tazhate/k8s-debug-container-stress@sha256:ed01e0719cc59b3891f9df73c45e2284dcd97530c2b0101698811444b6281d85"
GPROFILER_IMAGE="intel/gprofiler:1.57.1@sha256:e204c3ad03bf2ee822cb55b6493685926e64d64907c2b83a683d0c49b47a5c6b"

# Images the lab workloads themselves run (lab manifests).
NGINX_IMAGE="nginx:1.30.6-alpine@sha256:0e52bd054126cdc040b1276c0af347aeb02a41b9cfe305d6094767ac30e97949"
BUSYBOX_IMAGE="busybox:1.37@sha256:a7dbc319b1438115a207e11930dc4bb3e643dcb3ec0bdd694bb36cd8fad289ec"
POSTGRES_IMAGE="postgres:18.4@sha256:a02db8cac496f15b094798a38254f14d6e00741f709360e5e00bb6668ea31636"

# Variable names that scripts/preload.sh handles.
RUNTIME_IMAGE_VARS="NETSHOOT_IMAGE NGINX_IMAGE BUSYBOX_IMAGE POSTGRES_IMAGE"
DEBUG_IMAGE_VARS="JDK_IMAGE STORAGE_IMAGE DB_IMAGE PERF_IMAGE STRESS_IMAGE GPROFILER_IMAGE"
